---
import { Image } from "astro-preload/components";
import payload from "../payload";
import { convertLexicalToHTML } from "@payloadcms/richtext-lexical/html";

const contact = await payload.findGlobal({
    slug: "contact",
    depth: 2
});
---

<section id="contact">
    <div set:html={convertLexicalToHTML({ data: contact.contactContent })} />

    <div class="contact-grid">
        {
            contact.contactPersons.map((contact) => (
                <div class="contact-card">
                    <div class="contact-info">
                        <h3>{contact.name}</h3>
                        <p>
                            <strong>{contact.role}</strong>
                        </p>
                        <p>
                            <span class="icon">📧</span>
                            <span>{contact.email}</span>
                        </p>
                        <p>
                            <span class="icon">📞</span>
                            <span>{contact.phone}</span>
                        </p>
                    </div>
                    <Image
                        url={decodeURI(contact.photo!.url + "?w=400&h=400&fit=thumb")}
                        alt={contact.name}
                    />
                </div>
            ))
        }
    </div>

    <div set:html={convertLexicalToHTML({ data: contact.confidentialContent })} />

    <div class="contact-grid">
        {
            contact.confidentialContactPersons.map((contact) => (
                <div class="contact-card">
                    <div class="contact-info">
                        <h3>{contact.name}</h3>
                        <p>
                            <strong>{contact.role}</strong>
                        </p>
                        <p>
                            <span class="icon">📞</span>{" "}
                            <span>{contact.phone}</span>
                        </p>
                    </div>
                    <Image
                        url={decodeURI(contact.photo!.url + "?w=400&h=400&fit=thumb")}
                        alt={contact.name}
                        class="contact-image"
                    />
                </div>
            ))
        }
    </div>
</section>

<style lang="scss">
    @use '../common';

    .contact-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 2rem;
        margin-top: 1.5rem;

        .contact-card {
            display: grid;
            grid-template-columns: 66.6% 33.3%;
            background: #fff;
            border-radius: 10px;
            overflow: hidden;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
            width: 100%;
            border-left: 10px solid common.$board-colour;

            .contact-info {
                margin: auto 1.5rem;

                h3 {
                    margin: 0;
                    font-size: 1.4rem;
                    font-weight: bold;
                }

                p {
                    margin: 0.2rem 0;

                    span {
                        font-size: 0.85rem;
                    }
                }
            }

            img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

            strong {
                color: black;
                hyphens: auto;
            }
        }
    }

    @media (min-width: 767px) {
        .contact-grid {
            grid-template-columns: 1fr 1fr;
        }
    }
</style>
