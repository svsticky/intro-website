---
import payload from "../payload";
import { convertLexicalToHTML } from "@payloadcms/richtext-lexical/html";

const smallprint = await payload.findGlobal({ slug: "small-print" });
---

<!-- TODO: There used to be extra logic that made links open in a new tab, we might want to implement that again here -->
<section
    id="smallprint"
    set:html={convertLexicalToHTML({ data: smallprint.content })}
/>
