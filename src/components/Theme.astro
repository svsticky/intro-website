---
import { Image } from "astro:assets";
import payload from "../payload";
import { convertLexicalToHTML } from "@payloadcms/richtext-lexical/html";

const theme = await payload.findGlobal({ slug: "theme", depth: 2 });
---

<section id="theme">
    <div set:html={convertLexicalToHTML({ data: theme.content })} />

    {!!theme.reveal && <div class="theme-box" set:html={convertLexicalToHTML({ data: theme.reveal })} />}

    { theme.supermentorText &&
        <div set:html={convertLexicalToHTML({ data: theme.supermentorText })} /> }

    <div class="supermentors">
        {
            (theme.supermentors ?? []).map((mentor) =>
                <div class="supermentor">
                    <h3>{mentor.name}</h3>
                    <div class="mentor-content">
                        <Image
                            src={(mentor.picture!.url + "?w=400&h=400&fit=thumb")}
                            width={mentor.picture.width}
                            height={mentor.picture.height}
                            alt={mentor.picture!.alt}
                        />
                        <div set:html={convertLexicalToHTML({ data: mentor.content })} />
                    </div>
                </div>
            )
        }
    </div>
</section>

<style lang="scss">
    .supermentor {
        overflow: auto;
        padding-bottom: 1rem;
        border-bottom: 1px solid #e0e0e0;

        h3 {
            margin-bottom: 0.5rem;
        }

        .mentor-content {
            position: relative;
            overflow: auto;

            img {
                float: right;
                width: 50%;
                max-width: 200px;
                height: auto;
                object-fit: cover;
                border-radius: 0.5rem;
                margin-bottom: 0.5rem;
                margin-left: 1rem;
                clear: both;
                display: inline-block;
                aspect-ratio: 1 / 1;
            }
        }
    }

    .theme-box {
        display: grid;
        width: 100%;

        :global(.payload-richtext) {
            display: grid;

            :global(img) {
                width: 100%!important;
                max-width: 600px;
                height: auto!important;
                border-radius: 0.5rem;
                margin: auto;
            }
        }
    }
</style>
